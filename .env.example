# Copy this file to .env and fill in every value before running the server.
# .env is gitignored — never commit it.
#
# Quickstart:
#   1. Fill in the Supabase section manually (dashboard values, never generated by Terraform)
#   2. Run `./scripts/sync-env.sh staging` to auto-fill the Terraform-derived values
#      (requires terraform apply to have been run at least once)
#   3. Set APP_ENV to match your target (development / staging / production)

# ── App ───────────────────────────────────────────────────────────────────────

APP_ENV=development
# Values: development | staging | production
# Controls auth strictness and log verbosity.

# ── Supabase ──────────────────────────────────────────────────────────────────
# All three values are in: Supabase dashboard → your project → Settings → API

# Project URL  (format: https://<ref>.supabase.co)
# Also available via: terraform output supabase_api_url
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key — safe to expose to the browser, enforces Row Level Security
# Found under "Project API keys → anon / public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# JWT secret — server-side only, never expose to the browser
# Found under "JWT Settings → JWT Secret"
# Plain HS256 string — not a keypair. See lib/auth/config.ts.
SUPABASE_JWT_SECRET=

# ── Tus upload server (Render) ────────────────────────────────────────────────
# Public HTTPS URL of the Tus server deployed on Render.
# Get it from: terraform output tus_server_url
# Or from: Render dashboard → your service → the URL shown at the top
# Used by the browser to send resumable uploads directly to the Tus server.
NEXT_PUBLIC_TUS_SERVER_URL=

# ── Notes: variables NOT needed in .env ───────────────────────────────────────
#
# Tus server runtime vars (NODE_ENV, B2_KEY_ID, B2_APPLICATION_KEY,
# B2_BUCKET_NAME, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY) are set directly
# on the Render service by Terraform — they never live in this file.
#
# Terraform variables (B2 master key, Supabase access token, Render API key,
# etc.) live in infra/envs/<env>/terraform.tfvars — see terraform.tfvars.example
# in each environment directory.
#
# CI secrets (TF_API_TOKEN, PLAYWRIGHT_BASE_URL, etc.) are GitHub Actions
# secrets — set them in: repo → Settings → Secrets and variables → Actions.

# LEG-002 local Postgres integration tests.
# Used only when running tests/integration/legal/zip-jobs.postgres.test.ts.
LEG_002_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/onye_leg002

# LEG-002 live Backblaze B2 synthetic upload prototype.
# These must point at a non-production bucket and synthetic data only.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=
LEG_002_TOKEN_ID=leg002_synthetic_token
LEG_002_STUDY_ID=leg002_synthetic_study
LEG_002_SYNTHETIC_FILE_COUNT=500
LEG_002_SYNTHETIC_FILE_SIZE_BYTES=1048576

# PAT-101 patient SMS notification delivery.
# Runtime-only values for the Render-hosted token API service.
PAT101_INTERNAL_WEBHOOK_SECRET=
PAT101_APP_BASE_URL=https://app.onyesync.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
