APP_ENV=development
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-dashboard-settings-api

# Note: JWT secret is found in Supabase dashboard -> Settings -> API -> JWT Secret.
# It is a plain string (not a public/private keypair).
# Supabase uses HS256 (HMAC-SHA256) to sign JWTs — verified locally here,
# no network call. See lib/auth/tokens.ts for the JWKS/RS256 swap point.

# Only needed if you exercise lib/auth/supabase-server.ts's cookie-session
# wiring — unset is fine for the spike (auth is verified locally via the
# shared JWT secret above, not through a live Supabase connection).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LEG-002 local Postgres integration tests.
# Used only when running tests/integration/legal/zip-jobs.postgres.test.ts.
LEG_002_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/onye_leg002

# LEG-002 live Backblaze B2 synthetic upload prototype.
# These must point at a non-production bucket and synthetic data only.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=
LEG_002_TOKEN_ID=leg002_synthetic_token
LEG_002_STUDY_ID=leg002_synthetic_study
LEG_002_SYNTHETIC_FILE_COUNT=500
LEG_002_SYNTHETIC_FILE_SIZE_BYTES=1048576
